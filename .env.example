# Copy to .env before building a production monetized release.
# The checked-in defaults use Google's official test ads and earn no revenue.

VITE_ADS_ENABLED=true
VITE_ADMOB_USE_TEST=false

# Banner ad master switch. Set false to hide the bottom banner.
VITE_BANNER_ENABLED=true

VITE_ADMOB_ANDROID_REWARDED=ca-app-pub-XXXXXXXX/1111111111
VITE_ADMOB_ANDROID_INTERSTITIAL=ca-app-pub-XXXXXXXX/2222222222
VITE_ADMOB_ANDROID_BANNER=ca-app-pub-XXXXXXXX/5555555555
VITE_ADMOB_IOS_REWARDED=ca-app-pub-XXXXXXXX/3333333333
VITE_ADMOB_IOS_INTERSTITIAL=ca-app-pub-XXXXXXXX/4444444444
VITE_ADMOB_IOS_BANNER=ca-app-pub-XXXXXXXX/6666666666

VITE_REMOVE_ADS_PRODUCT_ID=com.reelhangman.game.removeads
