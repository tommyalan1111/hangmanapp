# Development environment for `npm run dev` and dev APKs (`npm run build:dev`).
#
# Vite loads this file for mode "development", and it overrides .env, so the
# live ad unit ids in .env never reach a dev build. Production builds
# (`npm run build`, mode "production") ignore this file.
#
# Check the Settings screen: a dev build shows
# "Version 1.3.23 · dev build (test ads)" instead of the plain version.

VITE_ADS_ENABLED=true
VITE_BANNER_ENABLED=true

# Google's official sample ad units. No revenue, no invalid traffic.
VITE_ADMOB_USE_TEST=true

# Register physical devices as AdMob test devices. Comma- or space-separated
# ids, e.g. 33BE2250B43518CCDA7DE426D04EE231. Find the id by running
# `adb logcat` and searching for "Use RequestConfiguration", or in the
# Ad Inspector tool. Emulators usually do not need this.
VITE_ADMOB_TESTING_DEVICES=

# To exercise live ad units safely on one device:
#   1. set VITE_ADMOB_USE_TEST=false in this file,
#   2. put that device's id in VITE_ADMOB_TESTING_DEVICES,
#   3. run build-apk-dev.ps1 and confirm Settings says "dev build (live ads)".
# Google demand will then serve test ads to that device. Mediation partners
# may ignore the Google test-device flag and serve real ads, so do not tap
# them until each network's own test mode is configured. Never tap live ads
# from an unregistered device or emulator: AdMob treats that as invalid
# traffic and can suspend the account.

VITE_REMOVE_ADS_PRODUCT_ID=com.reelhangman.game.removeads
